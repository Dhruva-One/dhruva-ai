# Platform API: the only source of school data (never read the platform database directly).
PLATFORM_API_URL=http://localhost:3000
# Model provider: "fake" runs offline with canned output for local development.
MODEL_PROVIDER=fake
# Prompts with student or staff data must be inferred in an India region (XCT-NFR-008, AI 5.7).
INFERENCE_REGION=ap-south-1
# Per-tenant daily budget in US cents (cost metering).
DEFAULT_TENANT_DAILY_BUDGET_CENTS=500
